# Backend (Node.js)
PORT=3000
# Local con Docker: postgresql://campusiot:campusiot@localhost:5432/campusiot
# Supabase: copiar la cadena "Connection string" (pooler) del panel y poner DATABASE_SSL=true
DATABASE_URL=postgresql://campusiot:campusiot@localhost:5432/campusiot
DATABASE_SSL=false
CORS_ORIGIN=http://localhost:3000
# Protege la calibración (PUT /api/spaces/:slug/config). Poner una clave larga en producción.
ADMIN_KEY=cambiar-esta-clave

# Reglas del sistema
OFFLINE_AFTER_S=30
EXPECTED_INTERVAL_S=3
